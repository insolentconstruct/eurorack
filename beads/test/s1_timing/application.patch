+// A held block that the firmware silences still holds, and plays the sine.
+inline void CeilingSilence(FloatFrame* frames, Codec::Frame* out,
+    size_t size, bool gate_output) {
+  FloatFrame silence;
+  silence.l = 0.0f;
+  silence.r = 0.0f;
+  fill(&frames[0], &frames[size], silence);
+  cpu_ceiling::Output(frames, out, size, gate_output);
+}
+
+// Codec and synth both run one block per 250 us at independent rates.
+template<bool fixed_decay, bool extended_reverb>
+inline void RenderPlaits(SeedButtonState button, const GateFlags* seed,
+    const bool* freeze, Synth::Resolution resolution,
+    const ModulatedParameter& density, const Parameters& parameters,
+    const Processor::MixParameters& mix, FloatFrame* out, size_t size) {
+  const size_t synth_size = plaits_synth.sample_rate() / kBlockRate;
+  if (size == synth_size) {
+    if (extended_reverb) {
+      plaits_synth.RenderCharacter(button, seed, freeze, resolution, density,
+          parameters, mix, out, size);
+    } else if (fixed_decay) {
+      plaits_synth.RenderFixedDecay(button, seed, freeze, resolution, density,
+          parameters, mix, out, size);
+    } else {
+      plaits_synth.Render(button, seed, freeze, resolution, density, parameters,
+          mix, out, size);
+    }
+    return;
+  }
+
+  GateFlags synth_seed[kMaxCodecBlockSize];
+  bool synth_freeze[kMaxCodecBlockSize];
+  FloatFrame synth_out[kMaxCodecBlockSize];
+  for (size_t i = 0; i < synth_size; ++i) {
+    const size_t first = i * size / synth_size;
+    const size_t end = (i + 1) * size / synth_size;
+    uint32_t flags = seed ? seed[first] : 0;
+    synth_freeze[i] = freeze[first];
+    if (i && first == (i - 1) * size / synth_size) {
+      flags &= GATE_FLAG_HIGH;
+    }
+    for (size_t j = first + 1; j < end; ++j) {
+      flags |= seed ? seed[j] : 0;
+      synth_freeze[i] |= freeze[j];
+    }
+    synth_seed[i] = GateFlags(flags);
+  }
+  const GateFlags* resized_seed = seed ? synth_seed : NULL;
+  if (extended_reverb) {
+    plaits_synth.RenderCharacter(button, resized_seed, synth_freeze, resolution, density,
+        parameters, mix, synth_out, synth_size);
+  } else if (fixed_decay) {
+    plaits_synth.RenderFixedDecay(button, resized_seed, synth_freeze, resolution, density,
+        parameters, mix, synth_out, synth_size);
+  } else {
+    plaits_synth.Render(button, resized_seed, synth_freeze, resolution, density, parameters,
+        mix, synth_out, synth_size);
+  }
+  for (size_t i = 0; i < size; ++i) {
+    out[i] = synth_out[i * synth_size / size];
+  }
+}
