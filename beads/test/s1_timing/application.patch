+    result |= beads::s1_timing::kDmaMiss;
+    const uint32_t half_words = 2 * beads::s1_timing::frame.block_frames;
+    const bool tc = current == CODEC_ADC_DMA_ISR_FLAG_TC;
+    const bool tc_phase = !remaining || remaining > half_words;
+    if (status & current) {
+      // Convert the entry NDTR into words until this flag can recur.
+      // At NDTR zero the circular reload is at the TC boundary.
+      const uint32_t entry_words = entry_remaining ? entry_remaining
+          : 2 * half_words;
+      const uint32_t words_to_repeat = tc ? entry_words :
+          (entry_words > half_words ? entry_words - half_words
+                                    : entry_words + half_words);
+      const uint32_t period = SystemCoreClock / 4000;
+      const uint32_t elapsed = beads::s1_timing::Cycles() - start;
+      if (tc_phase == tc || elapsed >= 2 * period ||
+          elapsed * half_words >= period * words_to_repeat) {
+        result |= beads::s1_timing::kDmaLost;
+      }
+    }
+  }
+  return result;
+}
