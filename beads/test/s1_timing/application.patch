+static uint32_t FinishHalf(uint32_t start, uint32_t current,
+    uint32_t following, uint32_t entry_remaining, bool filled) {
+  const uint32_t status = CODEC_ADC_DMA_ISR;
+  const uint32_t remaining = CODEC_ADC_DMA_STREAM->NDTR;
+  CODEC_ADC_DMA_IFCR = current;
